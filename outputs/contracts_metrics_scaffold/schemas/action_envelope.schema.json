{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_envelope.schema.json",
  "title": "Small SWE Train Assistant Tool Call Envelope v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_calls"],
  "properties": {
    "thinking": {
      "type": "string",
      "description": "Optional reasoning text extracted from <think>...</think> delimiters."
    },
    "tool_calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/toolCall"
      }
    }
  },
  "$defs": {
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args"],
      "properties": {
        "tool": {
          "type": "string",
          "enum": ["bash", "search", "edit", "submit"]
        },
        "args": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "bash"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tool_args.schema.json#/$defs/bashArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "search"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tool_args.schema.json#/$defs/searchArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "edit"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tool_args.schema.json#/$defs/editArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "submit"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tool_args.schema.json#/$defs/submitArgs"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_calls": {
            "contains": {
              "type": "object",
              "required": ["tool"],
              "properties": {
                "tool": {
                  "const": "submit"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tool_calls": {
            "maxItems": 1
          }
        }
      }
    }
  ]
}
