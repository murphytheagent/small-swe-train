{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_envelope.schema.json",
  "title": "Small SWE Train Assistant Tool Call Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "args"],
  "properties": {
    "thinking": {
      "type": "string",
      "description": "Optional reasoning text extracted from <think>...</think> delimiters."
    },
    "tool": {
      "type": "string",
      "enum": ["bash", "search", "edit", "answer"]
    },
    "args": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "bash"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "tool_args.schema.json#/$defs/bashArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "search"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "tool_args.schema.json#/$defs/searchArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "edit"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "tool_args.schema.json#/$defs/editArgs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "answer"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "tool_args.schema.json#/$defs/answerArgs"
          }
        }
      }
    }
  ]
}
