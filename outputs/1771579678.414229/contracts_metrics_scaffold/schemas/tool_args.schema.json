{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_args.schema.json",
  "title": "Small SWE Train Tool Args v2",
  "$defs": {
    "bashArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Single shell command executed in sandbox."
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "Optional working directory within sandbox."
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 120
        }
      }
    },
    "searchArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Search expression for repository/content lookup."
        },
        "path_hint": {
          "type": "string",
          "description": "Optional path scope hint used to narrow search."
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5
        }
      }
    },
    "editArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "patch"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "patch": {
          "type": "string",
          "minLength": 1,
          "description": "Unified diff patch text for the target file."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "answerArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_response"],
      "properties": {
        "final_response": {
          "type": "string",
          "minLength": 1
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
